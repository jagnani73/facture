{
  "name": "@facture/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@facture/shared": "workspace:*",
    "@hiero-ledger/sdk": "^2.85.0",
    "@hono/node-server": "^1.19.0",
    "@x402/core": "2.24.0",
    "@x402/fetch": "2.24.0",
    "@x402/hedera": "2.24.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.9.0",
    "postgres": "^3.4.7",
    "viem": "^2.40.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
