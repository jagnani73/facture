# Server
NODE_ENV=development|production|test    # default: development
PORT=8787
LOG_LEVEL=debug|info|warn|error         # default: info
PUBLIC_BASE_URL=http://localhost:8787   # this API's own origin
PUBLIC_APP_BASE_URL=http://localhost:3000  # where the debtor reads the confirmation page
CONFIRMATION_TOKEN_SECRET!              # >=32 chars; HMACs the debtor confirmation tokens

# Hedera
# Chain ids, RPC and mirror-node URLs are not here — they come from @facture/shared.
HEDERA_OPERATOR_ID!                     # 0.0.x
# Changing this changes the seeded seller's identity: its arc_address and hedera_account_id
# are this key's derived address, so a rotation silently points them at an account nobody
# controls - a payout would settle, report success, and pay no one. See migration 0005.
HEDERA_OPERATOR_KEY!                    # ECDSA only; ED25519 cannot sign EVM transactions
ATS_FACTORY_ID                          # 0.0.x of the ATS factory; unset disables issuance
ISSUANCE_GAS_LIMIT=10000000             # deployBond measures ~7M against a 15M ceiling
ISSUANCE_MIN_INTERVAL_MS=4000           # pacing floor; Hedera throttles on network gas throughput
ISSUANCE_MAX_ATTEMPTS=6
ISSUANCE_BACKOFF_BASE_MS=2000
MATURITY_COLLECTION_ACCOUNT_ID          # 0.0.x paying matured receivables; must not be the operator, unset disables the rail
# The secondary market. A resale's ATS hold is signed by whoever HOLDS the paper -
# createHoldByPartition acts on the caller's own tokens and the deployed diamond has no
# operator route to it. So this is custody of a buyer's key, and it is named as such. The
# holder is derived from the key, never named beside it: an ECDSA account has two EVM
# addresses and the two spellings never compare equal. Unset disables resale.
RESALE_SIGNER_PRIVATE_KEY               # ECDSA; the venue resells only for the holder this derives

# Arc
ARC_SETTLEMENT_PRIVATE_KEY!             # 0x + 64 hex; the vault's attester AND a spending key
                                        # on the settlement path - needs USDC for Arc gas
ARC_MAX_FEE_PER_GAS_GWEI=20             # under 20 Arc rejects as underpriced

# x402 / Blocky402
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_SETTLEMENT_SCALE_PPM=1             # ppm scale, both rails; 1000000 = full amount

# Database
DATABASE_URL!                           # SQLite file path, e.g. ./data/facture.db (or :memory:)

# Privy - seller sign-in. Unset disables POST /v1/sellers rather than accepting an
# unverified email; the app id is also public and lives in the web package.
PRIVY_APP_ID                            # with the secret or neither; unset disables seller sign-in
PRIVY_APP_SECRET
# Wallet policy scoping the seller's embedded wallet to DvpEscrow.claim on Arc. Unset leaves
# that wallet unscoped. Created once by provisionClaimPolicy(); needs the two vars above.
PRIVY_WALLET_POLICY_ID                  # from `pnpm privy:policy`; unset leaves wallets unscoped
PRIVY_AUTHORIZATION_PRIVATE_KEY         # only for a Privy app with an authorization keypair

# Hedera Consensus Service - refusal receipts AND settled matches. Unset records both without
# a consensus copy; the topic carries sha256 commitments, never the reason or the terms.
HCS_REFUSAL_TOPIC_ID
