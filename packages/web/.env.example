# Data source
# Unset NEXT_PUBLIC_API_BASE_URL and the demo book in src/lib/fixtures.ts renders instead.
NEXT_PUBLIC_FACTURE_DATA_SOURCE=api|fixtures   # default: inferred from the base URL below
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# Who the screens are looking at. Required in api mode; the venue scopes every
# seller and buyer route by UUID and answers 422 for anything else.
# The seller is a fallback now: a signed-in one takes precedence. See src/lib/api/identity.ts.
NEXT_PUBLIC_SELLER_ID
NEXT_PUBLIC_BUYER_ID

# Privy — seller sign-in. Unset hides the control and the seller above keeps rendering.
# The app id is public by design and belongs in the bundle; the app SECRET is a server
# credential and must never be given a NEXT_PUBLIC_ prefix, which means "inline this".
NEXT_PUBLIC_PRIVY_APP_ID
