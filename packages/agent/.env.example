# Circle — developer-controlled wallets
# No policy engine on this path: the mandate cap is enforced in src/mandate.ts, not by Circle.
CIRCLE_API_KEY!
CIRCLE_ENTITY_SECRET!                        # 64 hex chars, no 0x prefix
CIRCLE_BASE_URL=https://api.circle.com

# Arc — testnet only, mainnet lands after submissions close
ARC_BLOCKCHAIN=ARC-TESTNET
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000   # ERC-20, 6dp (native gas is 18dp)

# The venue
FACTURE_API_URL=http://localhost:8787
FACTURE_API_TIMEOUT_MS=10000
AGENT_BUYER_ID!                              # whose mandates this process operates
AGENT_SELLER_IDS!                            # comma-separated; the book is read per seller
AGENT_MANDATE_IDS                            # comma-separated; empty means every active mandate

# The wallet backing the mandates
AGENT_WALLET_ID!
AGENT_WALLET_SET_ID

# The loop
AGENT_POLL_INTERVAL_MS=15000
AGENT_MAX_SLIPPAGE_BPS=0
AGENT_DRY_RUN=true|false                     # default: true — arming a trade commits the mandate
AGENT_ONCE=true|false                        # default: false
LOG_LEVEL=debug|info|warn|error              # default: info
