# Hedera testnet — the book, the gate, the registry, the paper
HEDERA_TESTNET_PRIVATE_KEY!             # ECDSA hex key; ED25519 cannot sign EVM txs

# Arc testnet — the cash leg
ARC_TESTNET_PRIVATE_KEY!
ARC_USDC_ADDRESS!                       # USDC on Arc, ERC-20 interface (6 decimals)

# Roles
FACTURE_OWNER!                          # role curator on both chains
FACTURE_ATTESTER!                       # relays vault deposits and authorisations between chains
FACTURE_INVOICE_REGISTRY!               # deployed by @facture/backend; see README

# Cross-chain wiring
FACTURE_CASH_LEG_CHAIN_ID=5042002
FACTURE_MANDATE_VAULT                   # Arc vault address; required by deploy:hedera, set after deploy:arc
FACTURE_SETTLEMENT_WINDOW=259200        # seconds; must exceed DvpEscrow MAX_LOCK_DURATION (172800)

# Post-deploy wiring (optional; skipped when unset)
FACTURE_ISSUER                          # granted claim rights on the uniqueness registry
FACTURE_MATCHER                         # granted match rights on the mandate book
